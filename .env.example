# =============================================================================
# Gabriele & Giulia — variabili d'ambiente
# Copia in `.env.local` (sviluppo) o configura nel provider (produzione).
# In produzione le variabili "OBBLIGATORIE" sono verificate al boot: se manca
# anche solo una, l'app rifiuta di avviarsi (fail-closed). Non committare segreti.
# Genera i segreti con: openssl rand -base64 32   (oppure -hex 32)
# =============================================================================

# --- OBBLIGATORIE in produzione -------------------------------------------------

# Connessione PostgreSQL (Aurora/Neon/Supabase/...). Usa SSL in produzione.
DATABASE_URL="postgres://user:password@host:5432/dbname"

# Segreto di sessione Auth.js.
AUTH_SECRET="genera-con-openssl-rand-base64-32"

# Pepe HMAC per hashing (email, fingerprint di rate limit). 32+ byte.
AUTH_HMAC_PEPPER="genera-con-openssl-rand-hex-32"

# Chiave AES-256-GCM per cifrare i segreti admin (email, secret TOTP). base64, 32 byte.
AUTH_ENCRYPTION_KEY="genera-con-openssl-rand-base64-32"

# Pepe per l'hashing dei recovery code TOTP.
AUTH_RECOVERY_PEPPER="genera-con-openssl-rand-hex-32"

# Chiave AES-256-GCM per cifrare i dati bancari e i dettagli invitato. base64, 32 byte.
DATA_ENCRYPTION_KEY="genera-con-openssl-rand-base64-32"

# Segreto per l'hashing dei token personali degli invitati.
GUEST_TOKEN_SECRET="genera-con-openssl-rand-hex-32"

# Segreto per il fingerprint delle richieste (idempotenza/rate limit, no IP in chiaro).
REQUEST_FINGERPRINT_SECRET="genera-con-openssl-rand-hex-32"

# URL pubblico del sito (usato per canonical, OG, sitemap, controllo origin).
NEXT_PUBLIC_SITE_URL="https://giuliaegabriele.love"

# --- OPZIONALI / integrazioni ---------------------------------------------------

# Vercel Blob: token per gli upload media diretti autorizzati.
BLOB_READ_WRITE_TOKEN=""

# Nota: i form pubblici NON usano Turnstile né raccolgono email dagli invitati
# (solo nome e telefono). L'anti-abuso è affidato a honeypot + rate limiting.

# Resend (email admin transazionali). OPZIONALE: se assente, le email vengono
# registrate come "skipped" e nessuna mutation viene annullata.
RESEND_API_KEY=""
EMAIL_FROM="Giulia e Gabriele <noreply@giuliaegabriele.love>"
ADMIN_NOTIFICATION_EMAIL=""

# Identità client fidata dietro proxy/Vercel (header da cui leggere l'IP).
TRUSTED_PROXY_IP_HEADER="x-vercel-forwarded-for"

# --- PARAMETRI (con default sensati) --------------------------------------------

# Durata del blocco prenotazione/contributo, in ore (default 48).
GIFT_HOLD_HOURS="48"

# Rate limit dei form pubblici: numero massimo e finestra in secondi.
PUBLIC_FORM_RATE_LIMIT="8"
PUBLIC_FORM_RATE_WINDOW_SECONDS="900"

# Modalità demo (SOLO sviluppo/test): mostra contenuti dimostrativi.
# Non ha alcun effetto in produzione.
WEDDING_DEMO_MODE="false"
