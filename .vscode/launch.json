{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Next.js debug (server)",
        "type": "node",
        "request": "launch",
        "runtimeExecutable": "${env:HOME}/Library/pnpm/pnpm",
        "runtimeArgs": ["dev"],
        "cwd": "${workspaceFolder}",
        "console": "integratedTerminal",
        "skipFiles": ["<node_internals>/**"]
      }
    ]
  }